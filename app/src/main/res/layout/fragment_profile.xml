<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/profileRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/profileImageView"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_person"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_profile_circle"
            android:padding="4dp" />

        <TextView
            android:id="@+id/profileNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SaadPay User"
            style="@style/TextAppearance.Fintech.Title"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/profileEmailTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="saadpayuser@example.com"
            style="@style/TextAppearance.Fintech.Secondary"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/fingerprintStatusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fingerprint is enabled ✅"
            style="@style/TextAppearance.Fintech.Secondary"
            android:textColor="@color/success"
            android:layout_marginBottom="32dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardCornerRadius="20dp"
            card_view:cardElevation="0dp"
            card_view:cardBackgroundColor="@color/background"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="👉 Enable Fingerprint"
                    style="@style/TextAppearance.Fintech.Body" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/biometricSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/changePinCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            card_view:cardCornerRadius="20dp"
            card_view:cardElevation="0dp"
            card_view:cardBackgroundColor="@color/background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐 Change PIN"
                style="@style/TextAppearance.Fintech.Body"
                android:padding="20dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/forgotPinCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            card_view:cardCornerRadius="20dp"
            card_view:cardElevation="0dp"
            card_view:cardBackgroundColor="@color/background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❓ Forgot PIN"
                style="@style/TextAppearance.Fintech.Body"
                android:padding="20dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/helpSupportCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            card_view:cardCornerRadius="20dp"
            card_view:cardElevation="0dp"
            card_view:cardBackgroundColor="@color/background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📧 Help &amp; Support"
                style="@style/TextAppearance.Fintech.Body"
                android:padding="20dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/termsPrivacyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            card_view:cardCornerRadius="20dp"
            card_view:cardElevation="0dp"
            card_view:cardBackgroundColor="@color/background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📄 Terms &amp; Privacy"
                style="@style/TextAppearance.Fintech.Body"
                android:padding="20dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/logoutCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            card_view:cardCornerRadius="20dp"
            card_view:cardElevation="0dp"
            card_view:cardBackgroundColor="#FFF0F0">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚪 Logout"
                style="@style/TextAppearance.Fintech.Body"
                android:textColor="@color/error"
                android:padding="20dp" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/appVersionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 1.1.2"
            style="@style/TextAppearance.Fintech.Secondary"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
